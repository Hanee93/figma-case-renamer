{
  "name": "figma-case-renamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Figma plugin: batch-rename selected layers to camelCase / PascalCase / snake_case / kebab-case / CONSTANT_CASE / Title Case, with Korean (Hangul) handling",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=plugin/code.js --target=es2020 --format=iife",
    "watch": "npm run build -- --watch",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
